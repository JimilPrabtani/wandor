# Amazon Cognito user pool id, e.g. us-east-1_AbCdEfGhI
VITE_COGNITO_USER_POOL_ID=

# Cognito app client id (public client, no secret)
VITE_COGNITO_CLIENT_ID=

# Cognito Hosted UI domain as a bare hostname (no protocol), used for Google federated sign-in.
# e.g. wandor-123.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# CloudWatch RUM (optional -- monitoring is off if any are blank).
# Values come from `terraform -chdir=envs/data output` in waf-ops-platform.
VITE_RUM_APP_MONITOR_ID=
VITE_RUM_IDENTITY_POOL_ID=
VITE_RUM_GUEST_ROLE_ARN=
VITE_RUM_REGION=us-east-1
