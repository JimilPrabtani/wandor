# Google Identity Services OAuth client id (public client — baked into the
# bundle by design, safe to expose). Same value must also be set as the
# server-only GOOGLE_CLIENT_ID in Vercel so the API can verify ID tokens.
# Get it from Google Cloud Console -> APIs & Services -> Credentials, and add
# your Vercel URL + http://localhost:5173 as Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# --- Server-only (Vercel Environment Variables, NEVER prefixed with VITE_) ---
# Read by api/trips/generate.ts at request time. Set in the Vercel dashboard
# (Project Settings -> Environment Variables), not in this file.
# GOOGLE_CLIENT_ID=              # same GCP OAuth client id as above (aud check)
# OPENROUTER_API_KEY=            # required, server-only
# OPENROUTER_MODEL=              # e.g. meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_FALLBACK_MODEL=     # e.g. google/gemma-3-27b-it:free (optional)
