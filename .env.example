# Google Identity Services OAuth client id (public client — baked into the
# bundle by design, safe to expose). Same value must also be set as the
# server-only GOOGLE_CLIENT_ID below.
# Get it from Google Cloud Console -> APIs & Services -> Credentials, and add
# your Vercel URL + http://localhost:5173 as Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# --- Server-only (Vercel Environment Variables, NEVER prefixed with VITE_) ---
# Read by api/trips/generate.ts at request time. Set in the Vercel dashboard
# (Project Settings -> Environment Variables), not in this file.
# GOOGLE_CLIENT_ID=           # same GCP OAuth client id as above (aud check) — REQUIRED
# GEMINI_API_KEY=             # Google AI Studio key — REQUIRED (unless using only OpenRouter)
# GEMINI_MODEL=               # e.g. gemini-2.0-flash (default: gemini-2.0-flash). GOOGLE_MODEL works as an alias.
# OPENROUTER_API_KEY=         # fallback provider (optional if GEMINI_API_KEY set)
# OPENROUTER_MODEL=           # default: google/gemma-4-31b-it:free
# OPENROUTER_FALLBACK_MODEL=  # default: nvidia/nemotron-3-super-120b-a12b:free
